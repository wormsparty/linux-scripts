 #!/bin/sh

if which dnf > /dev/null 2>&1; then
	sudo dnf upgrade
	sudo dnf autoremove
fi

if which pacman > /dev/null 2>&1; then
	sudo pacman -Syu
	orphans=$(pacman -Qdtq)
	if [ -n "$orphans" ]; then
		sudo pacman -Rns $orphans
	fi
	if which paccache > /dev/null 2>&1; then
		sudo paccache -rk2
		sudo paccache -ruk0
	fi
fi

if which snap > /dev/null 2>&1; then
	sudo snap refresh
fi

if which flatpak > /dev/null 2>&1; then
	sudo flatpak update
	sudo flatpak uninstall --unused --delete-data
fi

if which apt > /dev/null 2>&1; then
	if [ "$1" != "1" ]; then
		sudo apt update
	fi
	sudo apt full-upgrade
	sudo apt autoremove
	sudo apt clean
fi
