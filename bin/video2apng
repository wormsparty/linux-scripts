#!/bin/sh

if [ $# -lt 1 ]; then
	echo "Usage: $(basename "$0") <input_file>"
	exit 1
fi

if [ ! -f "$1" ]; then
	echo "File not found: $1"
	exit 1
fi

ffmpeg -i "$1" -plays 0 -filter_complex "crop=ih:ih:(iw-ih)/2:0,fps=15,scale=150:-1:flags=lanczos,split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse" -f apng "${1%.*}.png"

